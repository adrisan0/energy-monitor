COMPOSE_PROJECT_NAME=energy-home-monitor

POSTGRES_DB=energy
POSTGRES_USER=energy
POSTGRES_PASSWORD=change-me-local-password
DATABASE_URL=postgresql+psycopg://energy:change-me-local-password@postgres:5432/energy

METER_URL=http://192.168.1.31/
METER_VALUES_PATH=/services/user/values.xml
METER_DEVICES_PATH=/services/user/devices.xml
METER_DEVICE_ID=wibeee
METER_POLL_INTERVAL_SECONDS=60
TIMEZONE=Europe/Madrid
SIMULATION_MODE=true

API_WRITE_TOKEN=change-me-local-admin-token
LOCAL_DEBUG_TECHNICAL=false
LOG_LEVEL=INFO

FEATURE_AUTOMATIONS=false
FEATURE_TELEGRAM=false
FEATURE_SMART_DEVICES=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKENS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_INTERVAL_SECONDS=3
TELEGRAM_ALERT_COOLDOWN_SECONDS=900
TELEGRAM_IMPORT_ALERT_MIN_W=200
TELEGRAM_IMPORT_ALERT_HOLD_SECONDS=120
HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=10
HOME_ASSISTANT_VERIFY_SSL=true

BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_SECONDS=86400

VITE_API_BASE_URL=/api/v1
