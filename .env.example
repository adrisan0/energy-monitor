COMPOSE_PROJECT_NAME=energy-home-monitor

POSTGRES_DB=energy
POSTGRES_USER=energy
POSTGRES_PASSWORD=change-me-local-password
DATABASE_URL=postgresql+psycopg://energy:change-me-local-password@postgres:5432/energy

METER_URL=http://192.168.1.31/
METER_VALUES_PATH=/services/user/values.xml
METER_DEVICES_PATH=/services/user/devices.xml
METER_DEVICE_ID=wibeee
METER_POLL_INTERVAL_SECONDS=60
METER_REQUEST_TIMEOUT_SECONDS=5
METER_REQUEST_ATTEMPTS=1
METER_REQUEST_RETRY_DELAY_SECONDS=2
TIMEZONE=Europe/Madrid
SIMULATION_MODE=true
WIBEEE_TARGET_WIFI_PASSWORD=
WIBEEE_TARGET_WIFI_SSID=
WIBEEE_RECOVERY_ENABLED=false
WIBEEE_MAC=
WIBEEE_AP_PREFIX=WIBEEE
WIBEEE_LOGIN_USER=
WIBEEE_LOGIN_PASSWORD=
WIBEEE_WIFI_SECURITY=WPA2-PSK
WIBEEE_WIFI_TYPEKEY=2
WIBEEE_MONITOR_INTERVAL=30
WIBEEE_PORTAL_IP=192.168.1.150
WIBEEE_PORTAL_TIMEOUT=5
WIBEEE_RECOVERY_COOLDOWN_SECONDS=900
WIBEEE_RECOVERY_MAX_ATTEMPTS=2
WIBEEE_FAILURE_CONFIRMATION_ATTEMPTS=3
WIBEEE_VALIDATION_ATTEMPTS=30
WIBEEE_VALIDATION_INTERVAL=5

API_WRITE_TOKEN=change-me-local-admin-token
LOCAL_DEBUG_TECHNICAL=false
LOG_LEVEL=INFO

FEATURE_AUTOMATIONS=false
FEATURE_TELEGRAM=false
FEATURE_SMART_DEVICES=false
SMART_PLUG_POLL_INTERVAL_SECONDS=60
FEATURE_DAIKIN=false
DAIKIN_API_BASE_URL=https://api.onecta.daikineurope.com/v1
DAIKIN_TOKEN_URL=https://idp.onecta.daikineurope.com/v1/oidc/token
DAIKIN_CLIENT_ID=
DAIKIN_CLIENT_SECRET=
# Initial refresh token. After startup, its rotation is stored in the daikin_data Docker volume.
DAIKIN_REFRESH_TOKEN=
DAIKIN_POLL_INTERVAL_SECONDS=300
DAIKIN_TIMEOUT_SECONDS=15
DAIKIN_MIN_REQUEST_INTERVAL_SECONDS=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKENS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_INTERVAL_SECONDS=3
TELEGRAM_ALERT_COOLDOWN_SECONDS=900
TELEGRAM_IMPORT_ALERT_MIN_W=200
TELEGRAM_IMPORT_ALERT_HOLD_SECONDS=120
HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=10
HOME_ASSISTANT_VERIFY_SSL=true

BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_SECONDS=86400

VITE_API_BASE_URL=/api/v1
