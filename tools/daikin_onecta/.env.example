# ONECTA developer portal values. Use only the values and URLs shown for your app.
DAIKIN_API_BASE_URL=https://api.onecta.daikineurope.com/v1
DAIKIN_TOKEN_URL=https://idp.onecta.daikineurope.com/v1/oidc/token
DAIKIN_CLIENT_ID=
DAIKIN_CLIENT_SECRET=
DAIKIN_REDIRECT_URI=
DAIKIN_SCOPES=openid onecta:basic.integration offline_access
# Optional authorization code returned to your registered redirect URI.
DAIKIN_AUTHORIZATION_CODE=
DAIKIN_REFRESH_TOKEN=

# Confirmed ONECTA Cloud API v1 paths
DAIKIN_DEVICES_PATH=/gateway-devices
DAIKIN_STATUS_PATH_TEMPLATE=/gateway-devices/{device_id}

# Optional legacy local controller addresses, comma-separated. No discovery scan.
DAIKIN_LOCAL_HOSTS=
